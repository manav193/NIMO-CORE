{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimo-core",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-28",
  "observability": { "enabled": true },
  "vars": {
    "OPENROUTER_MODELS": "google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct",
    "PROVIDER_TIMEOUT_MS": "7500",
    "PUBLIC_APP_URL": "https://manavagarwal.me",
    "ALLOWED_ORIGINS": "https://manavagarwal.me,https://www.manavagarwal.me,http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:4173"
  }
}
