{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimo-core",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "observability": { "enabled": true },
  "vars": {
    "OPENROUTER_MODELS": "openrouter/free,openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free",
    "PROVIDER_TIMEOUT_MS": "7500",
    "PUBLIC_APP_URL": "https://manavagarwal.me",
    "ALLOWED_ORIGINS": "https://manavagarwal.me,https://www.manavagarwal.me,http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:4173"
  }
}