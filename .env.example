# NIMO-CORE Local Environment Configuration Example
# Copy to .env or set in your environment before running `npm run dev`
#
# For Cloudflare Workers deployment:
# - Non-sensitive configuration is set in `wrangler.jsonc` (vars)
# - Secret keys should be set via: `npx wrangler secret put OPENROUTER_API_KEY`
# - Local worker dev uses: `.dev.vars` (see `.dev.vars.example`)

# Server port (default: 8787)
PORT=8787

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,https://manavagarwal.me,https://www.manavagarwal.me

# Rate limit per IP per minute (default: 60)
RATE_LIMIT_PER_MINUTE=60

# Optional OpenRouter AI provider fallback configuration
# Leave blank to run in 100% deterministic local-first mode
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Comma-separated model list with automatic failover
OPENROUTER_MODELS=openrouter/free

# Provider timeout in milliseconds
PROVIDER_TIMEOUT_MS=7500
