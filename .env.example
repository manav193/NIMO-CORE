# NIMO-CORE Local Environment Configuration Example
# Copy to .env or set in your environment before running `npm run dev`

PORT=8787
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,https://manavagarwal.me,https://www.manavagarwal.me
RATE_LIMIT_PER_MINUTE=60

# Optional OpenRouter AI provider fallback configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.0-flash-vl:free
PROVIDER_TIMEOUT_MS=7500

# Prompt-Aii bridge configuration
# URL of the deployed Prompt-Aii backend, e.g. https://prompt-ai.example.com
PROMPT_AI_URL=http://localhost:3001
# Must match the value configured on Prompt-Aii as NIMO_INTEGRATION_KEY
NIMO_INTEGRATION_KEY=replace_with_shared_secret
