{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIMO Workflow",
  "type": "object",
  "required": ["id", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "trigger": { "type": "object" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string" },
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "requiresApproval": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
